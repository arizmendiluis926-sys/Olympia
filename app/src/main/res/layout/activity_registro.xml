<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RegistroActivity">

    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/fondo_login"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardLogin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="30dp"
        app:cardCornerRadius="25dp"
        app:cardElevation="20dp"
        android:backgroundTint="@color/white"
        app:layout_constraintBaseline_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/layoutContenido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="28dp">

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registro de usuario"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#25B82B"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="30dp"
                />

            <EditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_input"
                android:hint="Nombre"
                android:paddingEnd="15dp"
                android:paddingStart="15dp"
                android:textColor="#333333"
                android:textColorHint="#0E9911"
                android:inputType="text"
                android:drawableStart="@drawable/user"
                android:drawablePadding="10dp"/>

            <EditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_input"
                android:hint="Correo"
                android:paddingEnd="15dp"
                android:paddingStart="15dp"
                android:textColor="#333333"
                android:textColorHint="#0E9911"
                android:inputType="textEmailAddress"
                android:drawableStart="@drawable/correo"
                android:layout_marginTop="20dp"
                android:drawablePadding="10dp"/>

            <EditText
                android:id="@+id/etPass"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_input"
                android:hint="Contraseña"
                android:paddingEnd="15dp"
                android:paddingStart="15dp"
                android:textColor="#333333"
                android:textColorHint="#0E9911"
                android:inputType="textPassword"
                android:drawableStart="@drawable/contrasena"
                android:drawablePadding="10dp"
                android:layout_marginTop="20dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRegistrar"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="REGISTRAR"
                android:background="@drawable/bg_buton"
                android:layout_marginTop="30dp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvIniciarSesion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Iniciar sesión ->"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1CBD27"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="60dp"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>